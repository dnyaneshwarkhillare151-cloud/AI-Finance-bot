# Application
SECRET_KEY=your-super-secret-jwt-key-change-in-production-please
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=60
DEBUG=False

# Database (SQLite by default - change to PostgreSQL for production)
DATABASE_URL=sqlite:///./finance_advisor.db
# DATABASE_URL=postgresql://user:password@localhost/finance_advisor

# Gemini AI (Required for AI features)
GEMINI_API_KEY=your-gemini-api-key-here
GEMINI_MODEL=gemini-1.5-flash

# CORS (comma-separated origins)
ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000

# App Settings
CURRENCY_SYMBOL=₹
COUNTRY=IN
